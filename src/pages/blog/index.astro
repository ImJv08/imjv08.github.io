---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BlogLayoutTabsHorizontal from "../../components/BlogLayoutTabsHorizontal.astro";

const blogPosts = await getCollection("blog", ({ data }) => data.published);
const categories = await getCollection("blogCategories");

console.log(
  "BLOG CATEGORIES:",
  categories.map((category) => ({
    id: category.id,
    title: category.data.title,
  }))
);

console.log(
  "BLOG POSTS:",
  blogPosts.map((post) => ({
    id: post.id,
    category: post.data.category,
    title: post.data.title,
  }))
);

const sortedCategories = categories.sort((a, b) => {
  const orderA = a.data.sortOrder ?? 0;
  const orderB = b.data.sortOrder ?? 0;

  if (orderA !== orderB) return orderA - orderB;

  return a.data.title.localeCompare(b.data.title);
});

const categoryGroups = sortedCategories
  .map((category) => ({
    slug: category.id,
    title: category.data.title,
    description: category.data.description,
    icon: category.data.icon,
    posts: blogPosts
      .filter((post) => post.data.category === category.id)
      .sort(
        (a, b) =>
          b.data.publishDate.getTime() -
          a.data.publishDate.getTime()
      ),
  }))
  .filter((group) => group.posts.length > 0);

const categorizedPosts = categoryGroups.flatMap((group) => group.posts);

const uncategorizedPosts = blogPosts
  .filter((post) => !categorizedPosts.some((item) => item.id === post.id))
  .sort(
    (a, b) =>
      b.data.publishDate.getTime() -
      a.data.publishDate.getTime()
  );
---

<Layout
  title="Blog"
  description="Mis artículos y publicaciones"
>
  <main class="max-w-6xl mx-auto px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4">Blog</h1>

      <p class="text-xl text-base-content/70">
        Artículos, experiencias y contenido relacionado con mi aprendizaje.
      </p>
    </div>

    <a href="/" class="btn btn-ghost btn-sm">
      Volver
    </a>

    {
      blogPosts.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-2xl text-base-content/60">
            No hay publicaciones todavía.
          </p>
        </div>
      ) : (
        <BlogLayoutTabsHorizontal
          categoryGroups={categoryGroups}
          uncategorizedPosts={uncategorizedPosts}
        />
      )
    }
  </main>
</Layout>