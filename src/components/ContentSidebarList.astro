---
import type { MarkdownHeading } from "astro";
import { ChevronRight } from "@lucide/astro";

interface Props {
  headings: MarkdownHeading[];
  idPrefix: string;
  variant: "mobile" | "desktop";
}

interface OutlineItem {
  heading: MarkdownHeading;
  children: MarkdownHeading[];
}

const { headings, idPrefix, variant } = Astro.props;
const items: OutlineItem[] = [];
let currentH2: OutlineItem | undefined;

for (const heading of headings) {
  if (heading.depth === 3) {
    currentH2?.children.push(heading);
    continue;
  }

  const item = { heading, children: [] };
  items.push(item);
  currentH2 = heading.depth === 2 ? item : undefined;
}
---

<ul
  class:list={[
    "space-y-1",
    { "border-l border-base-300 pl-3": variant === "mobile" },
  ]}
>
  {items.map(({ heading, children }) => {
    const hasSublevel = heading.depth === 2 && children.length > 0;
    const sublevelId = `${idPrefix}-${heading.slug}-sublevel`;

    return (
      <li data-content-sidebar-group={hasSublevel ? "" : undefined}>
        <div class="flex min-w-0 items-start gap-1">
          <a
            href={`#${heading.slug}`}
            class:list={[
              "content-sidebar-link block min-w-0 flex-1 border-l-2 border-transparent py-1.5 text-sm leading-snug text-base-content/65 transition-colors hover:border-primary hover:text-primary",
              { "rounded-r-md pr-2": variant === "mobile" },
              heading.depth === 1 ? "pl-2 font-semibold" : "pl-2 font-medium",
            ]}
            data-heading-slug={heading.slug}
            data-heading-depth={heading.depth}
            data-has-sublevel={hasSublevel ? "" : undefined}
          >
            {heading.text}
          </a>

          {hasSublevel && (
            <button
              type="button"
              class="content-sidebar-sublevel-toggle mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md text-base-content/50 transition-colors hover:bg-base-200 hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              aria-expanded="false"
              aria-controls={sublevelId}
              aria-label={`Show sections under ${heading.text}`}
              data-content-sidebar-toggle
            >
              <ChevronRight
                class="content-sidebar-sublevel-chevron size-4 transition-transform duration-200"
                aria-hidden="true"
              />
            </button>
          )}
        </div>

        {hasSublevel && (
          <ul
            id={sublevelId}
            class="content-sidebar-sublevel ml-3 mt-1 space-y-1 border-l border-base-300/70 pl-2"
            data-content-sidebar-sublevel
            hidden
          >
            {children.map((child) => (
              <li>
                <a
                  href={`#${child.slug}`}
                  class="content-sidebar-link block border-l-2 border-transparent py-1.5 pl-3 pr-1 text-xs leading-snug text-base-content/55 transition-colors hover:border-primary hover:text-primary"
                  data-heading-slug={child.slug}
                  data-heading-depth={child.depth}
                >
                  {child.text}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    );
  })}
</ul>
