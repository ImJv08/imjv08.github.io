---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import SkillBadge from "./SkillBadge.astro";

interface CategoryGroup {
  slug: string;
  title: string;
  description?: string;
  icon?: string;
  posts: CollectionEntry<"blog">[];
}

interface Props {
  categoryGroups: CategoryGroup[];
  uncategorizedPosts: CollectionEntry<"blog">[];
}

const { categoryGroups, uncategorizedPosts } = Astro.props;

const allPosts = [
  ...categoryGroups.flatMap((group) => group.posts),
  ...uncategorizedPosts,
].sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

function formatDate(date: Date) {
  return date.toLocaleDateString("es-CO", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<div class="tabs tabs-border">
  <!-- TODOS -->
  <input
    type="radio"
    name="blog-tabs"
    class="tab"
    aria-label="Todos"
    checked
  />

  <div class="tab-content border-base-300 bg-base-100 p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allPosts.map((post) => (
        <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
          <figure class="aspect-video">
            <Image
              src={post.data.image}
              alt={post.data.title}
              class="w-full h-full object-cover"
              width={600}
              height={400}
            />
          </figure>

          <div class="card-body">
            <time class="text-sm text-base-content/60">
              {formatDate(post.data.publishDate)}
            </time>

            <h2 class="card-title hover:text-primary transition-colors">
              <a href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </h2>

            <p class="text-base-content/80">
              {post.data.description}
            </p>

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-2">
                {post.data.tags.map((tag) => (
                  <SkillBadge skill={tag} />
                ))}
              </div>
            )}

            <div class="card-actions justify-end mt-4">
              <a
                href={`/blog/${post.id}`}
                class="btn btn-primary btn-sm"
              >
                Leer más
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- CATEGORÍAS -->
  {categoryGroups.map((group) => (
    <>
      <input
        type="radio"
        name="blog-tabs"
        class="tab"
        aria-label={group.title}
      />

      <div class="tab-content border-base-300 bg-base-100 p-6">
        {group.description && (
          <p class="text-base-content/70 mb-8">
            {group.description}
          </p>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {group.posts.map((post) => (
            <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
              <figure class="aspect-video">
                <Image
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover"
                  width={600}
                  height={400}
                />
              </figure>

              <div class="card-body">
                <time class="text-sm text-base-content/60">
                  {formatDate(post.data.publishDate)}
                </time>

                <h2 class="card-title hover:text-primary transition-colors">
                  <a href={`/blog/${post.id}`}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-base-content/80">
                  {post.data.description}
                </p>

                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {post.data.tags.map((tag) => (
                      <SkillBadge skill={tag} />
                    ))}
                  </div>
                )}

                <div class="card-actions justify-end mt-4">
                  <a
                    href={`/blog/${post.id}`}
                    class="btn btn-primary btn-sm"
                  >
                    Leer más
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </>
  ))}

  <!-- SIN CATEGORÍA -->
  {uncategorizedPosts.length > 0 && (
    <>
      <input
        type="radio"
        name="blog-tabs"
        class="tab"
        aria-label="Otros"
      />

      <div class="tab-content border-base-300 bg-base-100 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {uncategorizedPosts.map((post) => (
            <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
              <figure class="aspect-video">
                <Image
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover"
                  width={600}
                  height={400}
                />
              </figure>

              <div class="card-body">
                <time class="text-sm text-base-content/60">
                  {formatDate(post.data.publishDate)}
                </time>

                <h2 class="card-title hover:text-primary transition-colors">
                  <a href={`/blog/${post.id}`}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-base-content/80">
                  {post.data.description}
                </p>

                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {post.data.tags.map((tag) => (
                      <SkillBadge skill={tag} />
                    ))}
                  </div>
                )}

                <div class="card-actions justify-end mt-4">
                  <a
                    href={`/blog/${post.id}`}
                    class="btn btn-primary btn-sm"
                  >
                    Leer más
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </>
  )}
</div>