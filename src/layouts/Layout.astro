---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import FabFlower from "../components/FabFlower.astro";
import Dock from "../components/Dock.astro";
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";

// Load general singleton
const generalEntry = await getEntry("general", "index");
if (!generalEntry) {
  throw new Error('Missing required content entry: "general/index"');
}

const general = generalEntry.data;

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bloomfolio Template",
  description = "A modern portfolio template built with Astro and DaisyUI",
} = Astro.props;

// Custom blur-fade animation configuration
const blurFadeAnimation = {
  old: {
    name: "blurFadeOut",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "forwards",
  },
  new: {
    name: "blurFadeIn",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "backwards",
  },
};

const pageTransition = {
  forwards: blurFadeAnimation,
  backwards: blurFadeAnimation,
};

const origin = Astro.url.origin;
---

<!doctype html>
<html lang="en" transition:animate={pageTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={origin} />
    <meta property="og:image" content={`${origin}/images/og_home.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/images/og_home.png`} />
  </head>

  <body class="min-h-screen">

    <!-- Navigation -->
    {Astro.url.pathname === "/" && (
  <nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-40 bg-base-100/80 backdrop-blur-md border-b border-base-300"
  >
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center justify-center gap-8 h-16">

        <a href="/#about" class="nav-link" data-section="about">
          Sobre mí
        </a>

        <a href="/#projects" class="nav-link" data-section="projects">
          Evidencias
        </a>

        <a href="/#blog" class="nav-link" data-section="blog">
          Conocimientos personales
        </a>

      </div>
    </div>
  </nav>
)}

    <!-- Theme Controls - Fixed Position -->
    <div class="fixed top-4 right-4 z-50">
      {general.enableThemeSelector ? <ThemeSelector /> : <ThemeToggle />}
    </div>

    <!-- Page Content -->
    <slot />

    {
      general.extraLinksEnabled && (
        <>
          {/* FabFlower for desktop - show 'both' and 'fab' items */}
          <FabFlower
            extraLinks={general.extraLinks.filter(
              (link) => link.displayOn !== "dock"
            )}
          />

          {/* Dock for mobile - show 'both' and 'dock' items */}
          <Dock
            extraLinks={general.extraLinks.filter(
              (link) => link.displayOn !== "fab"
            )}
          />
        </>
      )
    }

    <!-- Navigation Script -->
    <script>
      function updateActiveSection() {
        const sections = ["inicio", "about", "projects", "blog"];

        let currentSection = "inicio";

        for (const id of sections) {
          const section = document.getElementById(id);

          if (section) {
            const rect = section.getBoundingClientRect();

            if (rect.top <= 120) {
              currentSection = id;
            }
          }
        }

        document
          .querySelectorAll(".nav-link[data-section]")
          .forEach((link) => {
            link.classList.toggle(
              "active",
              link.getAttribute("data-section") === currentSection
            );
          });
      }

      window.addEventListener("scroll", updateActiveSection);
      window.addEventListener("load", updateActiveSection);

      document.addEventListener("astro:page-load", updateActiveSection);
    </script>

    <!-- Smooth Scroll -->
    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      /* Navigation */
      #main-nav .nav-link {
        position: relative;
        padding: 0.5rem 0;
        color: oklch(var(--bc) / 0.65);
        transition: color 0.2s ease;
      }

      #main-nav .nav-link:hover {
        color: oklch(var(--p));
      }

      #main-nav .nav-link.active {
        color: oklch(var(--p));
      }

      #main-nav .nav-link.active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2px;
        background: oklch(var(--p));
        border-radius: 999px;
      }

      /* Initial Page Load Blur-Fade Animation */
      @keyframes pageLoadBlurFade {
        0% {
          opacity: 0;
          filter: blur(8px);
        }

        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      html {
        animation: pageLoadBlurFade 0.3s ease-in-out;
        animation-fill-mode: both;
      }

      /* Blur Fade View Transitions */
      @keyframes blurFadeIn {
        0% {
          opacity: 0;
          filter: blur(10px);
        }

        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      @keyframes blurFadeOut {
        0% {
          opacity: 1;
          filter: blur(0px);
        }

        100% {
          opacity: 0;
          filter: blur(10px);
        }
      }
    </style>

  </body>
</html>